# =============================================================================
# DocuResearch AI - Environment Configuration
# Copy this file to `.env` and fill in the values you have.
# ALL keys are optional at the framework level - missing providers are
# handled gracefully (features that need them are disabled/mocked).
# NEVER commit your real .env file.
# =============================================================================

# --- LLM Providers ------------------------------------------------------------
# OPENAI_API_KEY is the active provider (research planning, claim extraction,
# claim verification - see llm/factory.py). Without it, --topic runs still
# work but research planning falls back to a generic question template and
# claim extraction/verification are skipped (logged as warnings), never faked.
OPENAI_API_KEY=
# Not wired up yet - present for future provider switching (see llm/factory.py).
ANTHROPIC_API_KEY=

# --- Observability (optional) ------------------------------------------------
LANGSMITH_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=docuresearch-ai

# --- Database -----------------------------------------------------------------
# Local dev default (SQLite). For production point this at a Postgres DSN,
# e.g. postgresql+psycopg://user:pass@host:5432/docuresearch
DATABASE_URL=sqlite:///./data/docuresearch.db

# --- Filesystem -----------------------------------------------------------------
# Where fetched webpage content is cached (spec section 17), keyed by normalized URL.
CACHE_DIR=data/cache

# --- Research tool providers (optional; features degrade gracefully) --------
# SEARCH_API_KEY is a Tavily API key (https://tavily.com) - the default web
# search provider (tools/web_search.py). Without it, web search is skipped
# (logged as a warning) rather than failing the run.
SEARCH_API_KEY=
NEWS_API_KEY=
# Wikipedia needs no key; this just lets you turn the tool off entirely.
WIKIPEDIA_API_ENABLED=true
# Wikimedia's API rejects User-Agents with no identifying contact URL/email
# (403 "please respect our robot policy") - the default below satisfies it
# without configuration; override with your own URL/mailto: if you have one.
WIKIPEDIA_CONTACT=https://github.com/docuresearch-ai/docuresearch-ai

# --- Research limits / performance -------------------------------------------
MAX_RESEARCH_SOURCES=40
MAX_CONCURRENT_REQUESTS=5
REQUEST_TIMEOUT=30
# Adaptive research loop (spec section 52): how many extra passes chasing
# evidence for under-supported important claims are allowed before the
# pipeline moves on regardless (graph/nodes.py: expand_weak_claims).
MAX_RESEARCH_ITERATIONS=2

# --- Model defaults -------------------------------------------------------------
DEFAULT_MODEL=gpt-4o-mini
DEFAULT_TEMPERATURE=0.3

# --- App behavior --------------------------------------------------------------
LOG_LEVEL=INFO
ENVIRONMENT=development
